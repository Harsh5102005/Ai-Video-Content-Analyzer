# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Required ─────────────────────────────────────────────────────────────────────
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Optional overrides (defaults shown) ─────────────────────────────────────────
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # NVIDIA NIM model to use
# WHISPER_MODEL=base                               # Whisper size: tiny|base|small|medium|large
# EMBEDDING_MODEL=all-MiniLM-L6-v2                # HuggingFace sentence-transformer model
# DOWNLOAD_DIR=downloads                           # Directory for downloaded YouTube audio
# CHUNK_MINUTES=10                                 # Audio chunk duration in minutes
